 .../targets/aarch64_rocknix_linux_gnu.rs     | 44 ++++++++++++++++++
 .../spec/targets/arm_rocknix_linux_gnueabihf.rs | 37 +++++++++++++++
 .../targets/x86_64_rocknix_linux_gnu.rs      | 55 ++++++++++++++++++++++
 4 files changed, 139 insertions(+)
 create mode 100644 compiler/rustc_target/src/spec/targets/aarch64_rocknix_linux_gnu.rs
