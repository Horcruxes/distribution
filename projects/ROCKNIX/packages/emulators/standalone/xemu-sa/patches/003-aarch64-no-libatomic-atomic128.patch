diff --git a/meson.build b/meson.build
index 57b16b8..43e8466 100644
--- a/meson.build
+++ b/meson.build
@@ -3220,7 +3220,15 @@ if has_int128_type
       __atomic_compare_exchange_n(&p[4], &p[5], p[6], 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED);
       return 0;
     }'''
-  has_atomic128 = cc.links(atomic_test_128, args: qemu_isa_flags)
+  # ROCKNIX: on aarch64 this probe links only because the C driver defaults to
+  # -latomic_asneeded (libatomic); gcc itself emits __atomic_*_16 libcalls there
+  # (no LSE128), and the executable is linked with g++, which omits libatomic.
+  # Force the CONFIG_CMPXCHG128 path, which is inline and library-free.
+  if cpu == 'aarch64'
+    has_atomic128 = false
+  else
+    has_atomic128 = cc.links(atomic_test_128, args: qemu_isa_flags)
+  endif
 
   config_host_data.set('CONFIG_ATOMIC128', has_atomic128)
 
@@ -3229,8 +3237,12 @@ if has_int128_type
     # without optimization enabled.  Try again with optimizations locally
     # enabled for the function.  See
     #   https://gcc.gnu.org/bugzilla/show_bug.cgi?id=107389
-    has_atomic128_opt = cc.links('__attribute__((optimize("O1")))' + atomic_test_128,
-                                 args: qemu_isa_flags)
+    if cpu == 'aarch64'
+      has_atomic128_opt = false
+    else
+      has_atomic128_opt = cc.links('__attribute__((optimize("O1")))' + atomic_test_128,
+                                   args: qemu_isa_flags)
+    endif
     config_host_data.set('CONFIG_ATOMIC128_OPT', has_atomic128_opt)
 
     if not has_atomic128_opt
